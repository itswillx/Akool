# =============================================================================
# Coolify / build frontend (Vite — embutidas no bundle; Build Time = ON)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opcional — OAuth Google no frontend (quando implementado)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Nixpacks (Coolify) — também podem ficar só no nixpacks.toml
# NIXPACKS_NODE_VERSION=20
# NIXPACKS_SPA_OUTPUT_DIR=dist

# =============================================================================
# Supabase Edge Functions secrets (Dashboard → Edge Functions → Secrets)
# NÃO cadastrar no Coolify
# =============================================================================
# ALLOWED_ORIGINS=https://SUA-URL-COOLIFY,http://localhost:5173
# BACKUP_CRON_SECRET=your-cron-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# CLI local (npm run import:cards)
# =============================================================================
IMPORT_USER_EMAIL=you@example.com
IMPORT_USER_PASSWORD=your-password

# Opcional: import em massa sem login de usuário
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
