# Supabase (frontend + CLI import)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CLI card import (npm run import:cards)
IMPORT_USER_EMAIL=you@example.com
IMPORT_USER_PASSWORD=your-password

# Optional: admin bulk import without user login
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (frontend Drive connection)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Edge function secrets (reference)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# BACKUP_CRON_SECRET=your-cron-secret
