# =============================================================================
# Frontend (Vite) — variáveis VITE_* são embutidas no bundle em BUILD TIME.
# No Coolify, marque-as como "Build Variable". Ver docs/deploy-coolify.md
# =============================================================================

# Supabase (frontend + CLI import)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CLI card import (npm run import:cards)
IMPORT_USER_EMAIL=you@example.com
IMPORT_USER_PASSWORD=your-password

# Optional: admin bulk import without user login
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge function secrets (reference)
# BACKUP_CRON_SECRET=your-cron-secret
