# DEV-006: variáveis que as edge functions leem (Deno.env.get). Copie para
# supabase/functions/.env (fora do git) e rode:
#   npx supabase functions serve --env-file supabase/functions/.env
# Em produção/staging, ficam em Edge Functions → Secrets no painel.
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o Supabase injeta
# sozinho (local e remoto); não precisam estar aqui.

# CORS (_shared/cors.ts): origens permitidas, separadas por vírgula. Local:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# site-backup: segredo do disparo automático (header x-cron-secret).
BACKUP_CRON_SECRET=

# Sentry das functions (_shared/sentry.ts). Vazio = desligado.
SENTRY_DSN=
SENTRY_RELEASE=
